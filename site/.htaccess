# Cache policy for the generated OpenRTMP package website.
# HTML is short-lived so a deploy is visible on the next reload; assets may be
# reused for a few minutes. Conditioned on the response type so package files
# (deb, rpm, apk, zip, ...) keep their default caching.
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache, must-revalidate" "expr=%{CONTENT_TYPE} =~ m#^text/html#"
  Header set Cache-Control "public, max-age=300" "expr=%{CONTENT_TYPE} =~ m#^(text/css|(text|application)/javascript|image/svg\+xml)#"
</IfModule>
